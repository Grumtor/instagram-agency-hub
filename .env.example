NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Railway provides this automatically when you attach a Postgres plugin
DATABASE_URL="postgresql://user:password@localhost:5432/instagram_agency_hub?schema=public"

JWT_ACCESS_SECRET=change-me-to-a-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-min-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3001/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

OAUTH_STATE_SECRET=your-state-signing-secret-here

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
PUBLIC_UPLOAD_URL=http://localhost:3001/uploads
