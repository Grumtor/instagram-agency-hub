generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  posts            Post[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           WorkspaceMember[]
  instagramAccounts InstagramAccount[]
  posts             Post[]
  auditLogs         AuditLog[]
  messages          Message[]
}

model WorkspaceMember {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        String @default("MEMBER")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model InstagramAccount {
  id                       String    @id @default(cuid())
  workspaceId              String
  igUserId                 String    @unique
  igUsername               String
  accessTokenEncrypted     String   @db.Text
  accessTokenIV            String
  accessTokenTag           String
  tokenExpiresAt           DateTime?
  permissions              String   @db.Text
  accountType              String
  profilePicUrl            String?
  isActive                 Boolean   @default(true)
  connectedAt              DateTime  @default(now())
  lastTokenRefresh         DateTime?
  pageId                   String?
  pageAccessTokenEncrypted String?  @db.Text
  pageAccessTokenIV        String?
  pageAccessTokenTag       String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts           Post[]
  messages        Message[]
  accountInsights AccountInsight[]

  @@index([workspaceId])
}

model Post {
  id           String    @id @default(cuid())
  workspaceId  String
  igAccountId  String
  type         String
  caption      String?  @db.Text
  mediaUrls    Json
  thumbnailUrl String?
  scheduledAt  DateTime?
  publishedAt  DateTime?
  status       String    @default("DRAFT")
  igPostId     String?
  igPermalink  String?
  errorMessage String?  @db.Text
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  igAccount InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  insight   PostInsight?

  @@index([workspaceId])
  @@index([status, scheduledAt])
  @@index([igAccountId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model Message {
  id             String   @id @default(cuid())
  workspaceId    String
  igAccountId    String
  conversationId String
  senderId       String
  recipientId    String
  content        String   @db.Text
  direction      String
  sentAt         DateTime
  igMessageId    String?  @unique
  createdAt      DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  igAccount InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, igAccountId, conversationId])
  @@index([conversationId, sentAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model ConsumedOAuthState {
  id         String   @id @default(cuid())
  stateHash  String   @unique
  consumedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

model AccountInsight {
  id            String           @id @default(cuid())
  igAccountId   String
  date          DateTime
  impressions   Int              @default(0)
  reach         Int              @default(0)
  profileViews  Int              @default(0)
  followerCount Int              @default(0)
  fetchedAt     DateTime         @default(now())

  igAccount     InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@unique([igAccountId, date])
  @@index([igAccountId])
}

model PostInsight {
  id             String   @id @default(cuid())
  postId         String   @unique
  likeCount      Int      @default(0)
  commentCount   Int      @default(0)
  savedCount     Int      @default(0)
  reach          Int      @default(0)
  impressions    Int      @default(0)
  engagementRate Float    @default(0)
  fetchedAt      DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}
